{
  "manifest_version": 3,
  "name": "Media Sniffer & Downloader",
  "version": "1.1",
  "description": "Sniffs and downloads media stream URLs, HLS (.m3u8), and page DOM video links.",
  "permissions": [
    "webRequest",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Detected Videos"
  }
}
