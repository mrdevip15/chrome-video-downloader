{
  "manifest_version": 3,
  "name": "Media & Course Downloader",
  "version": "3.1.0",
  "description": "Sniffs media, downloads HLS/DASH streams (with MP4 remux and in-browser AES-128 decryption), bulk-downloads Udemy courses with folders, subtitles, articles and resources, and exports Widevine/CENC jobs for offline decryption.",
  "permissions": [
    "webRequest",
    "downloads",
    "activeTab",
    "tabs",
    "storage",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "udemy-crawler.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Media & Course Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
